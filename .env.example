# Drydock environment. Copy to .env (gitignored) and fill in.

PORT=3000

# --- x402 deploy-fee gate (Day 3) ------------------------------------
# CAIP-2 network. Hackathon default is Base Sepolia. For mainnet set this to
# eip155:8453 AND set web's NEXT_PUBLIC_X402_NETWORK to match.
X402_NETWORK=eip155:84532

# Facilitator that verifies the signed payment and submits the settlement tx.
# Default (no auth, supports Base Sepolia): https://x402.org/facilitator
# For Base MAINNET use Coinbase's hosted facilitator instead — set this to its
# URL and provide CDP_API_KEY_ID / CDP_API_KEY_SECRET.
X402_FACILITATOR_URL=https://x402.org/facilitator
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Address that receives deploy fees. REQUIRED — the server refuses to start
# without a valid one.
DRYDOCK_SELLER_ADDRESS=0xYOUR_RECEIVING_ADDRESS

# Flat deploy fee in whole USDC (default 0.01).
DRYDOCK_DEPLOY_FEE_USDC=0.01

# --- Persistent state (production / Railway) ------------------------
# Where retained per-deploy src.zip artifacts live. The redeploy feature reads
# these back off disk, so in production this MUST be a persistent volume path.
# Local dev: unset -> <repo>/deploys. Railway: set to a path under the mounted
# volume, e.g. /data/deploys.
# DRYDOCK_DEPLOYS_ROOT=
# Sibyl incident/pattern memory DB. Unset -> ~/.sibyl-memory/memory.db (wiped
# on every container rebuild). Railway: point at the same volume, e.g.
# /data/sibyl-memory/memory.db  (sibyl-memory-client creates the parent dir).
# SIBYL_MEMORY_DB=

# --- Deploy pipeline / static host (Day 4) --------------------------
# local      = Drydock serves the site itself at /s/<id>/ (no account, offline).
# netlify    = Netlify zip-deploy API (real public URL).
# cloudflare = Cloudflare Pages direct-upload API (free tier, no card).
# Unset = cloudflare if CLOUDFLARE_API_TOKEN+ACCOUNT_ID present, else netlify
#         if NETLIFY_AUTH_TOKEN present, else local.
DRYDOCK_STATIC_HOST=local
# Public base URL of THIS server (used to build local-host site URLs).
PUBLIC_BASE_URL=http://localhost:3000
# Netlify personal access token (app.netlify.com -> User settings -> Applications).
# NETLIFY_AUTH_TOKEN=
# Optional: reuse one Netlify site for every deploy instead of creating a fresh
# one each time (avoids hitting the account site limit).
# NETLIFY_SITE_ID=
# Cloudflare Pages: a free account (dash.cloudflare.com/sign-up), the Account
# ID (Workers & Pages -> right sidebar, or the hex in the dashboard URL), and
# a custom API token with exactly ONE permission: Account | Cloudflare Pages |
# Edit (My Profile -> API Tokens -> Create Custom Token). No Zone perms.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_PAGES_PROJECT=drydock   # optional; lowercase a-z0-9-, made on first deploy

# Override the USDC EIP-712 domain only if a test token's on-chain
# name()/version() disagrees with the SDK's default asset table.
# X402_USDC_EIP712_NAME=USDC
# X402_USDC_EIP712_VERSION=2

# --- Test harness (scripts/test-x402-sepolia.mjs) --------------------
# A throwaway Base Sepolia key holding test USDC (https://faucet.circle.com).
# Needs NO ETH. NEVER use a key with real funds.
TEST_BUYER_PRIVATE_KEY=0x...

# --- Sibyl memory: write + query paths (Day 4-5 second half) ---------
# Anthropic API key for the §8.2.2 reasoning-step call (Claude Opus 5).
# ANTHROPIC_API_KEY=sk-ant-...
# Python interpreter with sibyl-memory-client installed (`pip show
# sibyl-memory-client`). There is no Node SDK — src/memory/sibyl_bridge.py
# is a Python subprocess Node shells out to; see architecture.md §2.1's
# implementation note. Unset = a hardcoded verified-working path for this
# build env (see src/memory/sibylBridge.ts) — override if that's wrong.
# SIBYL_PYTHON_BIN=
# Sibyl DB path. Unset = the SDK default (~/.sibyl-memory/memory.db).
# SIBYL_MEMORY_DB=
# Sibyl tenant id. Unset = MemoryClient's DEFAULT_TENANT (no sibyl init /
# no bound account, per architecture.md's free-tier decision, §9 Q5).
# SIBYL_TENANT_ID=
# Python interpreter for the bridge. Unset -> `python3` on Linux/macOS, a
# hardcoded dev-machine path on Windows. Railway: `python3` (set in Dockerfile).
# SIBYL_PYTHON_BIN=python3

# --- Frontend (web/ — Next.js, separate Railway service) ------------
# Public URL of THIS backend, baked into the browser bundle at `next build`
# time. MUST be set on the web service BEFORE its build, or the frontend
# ships pointing at http://localhost:3000. No trailing slash.
#   NEXT_PUBLIC_DRYDOCK_API=https://drydock-backend-production.up.railway.app
# Real repo URL for the nav/footer GitHub link (optional).
#   NEXT_PUBLIC_GITHUB_URL=https://github.com/<you>/drydock
# Leave NEXT_PUBLIC_X402_NETWORK UNSET to stay on Base Sepolia (setting it to
# eip155:8453 switches the frontend to mainnet — do not).

# See docs/railway.md for the full deploy runbook.
